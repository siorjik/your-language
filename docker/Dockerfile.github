FROM node:20-alpine AS builder

RUN npm install -g pnpm

WORKDIR /app

ARG NEXT_PUBLIC_APP_HOST
ARG NEXTAUTH_URL
ARG NEXTAUTH_SECRET
ARG NEXT_PUBLIC_APP_ENV
ARG NEXT_PUBLIC_DICTIONARY_API_URL
ARG OPENAI_API_KEY
ARG AUTH_GOOGLE_ID
ARG AUTH_GOOGLE_SECRET
ARG AUTH_GITHUB_ID
ARG AUTH_GITHUB_SECRET
ARG DATABASE_URL
ARG JWT_SECRET
ARG LANGCHAIN_API_KEY
ARG LANGCHAIN_ENDPOINT
ARG LANGCHAIN_PROJECT
ARG LANGCHAIN_TRACING_V2
ARG MAILER_HOST
ARG MAILER_PASS
ARG MAILER_PORT
ARG MAILER_USER
ARG STORAGE_ACCESS_KEY
ARG STORAGE_ACCESS_KEY_ID
ARG STORAGE_ID
ARG STORAGE_NAME
ARG AWS_BUCKET_NAME
ARG AWS_DEFAULT_REGION
ARG AWS_ACCESS_KEY_ID
ARG AWS_SECRET_ACCESS_KEY

ENV NEXT_PUBLIC_APP_HOST=$NEXT_PUBLIC_APP_HOST
ENV NEXTAUTH_URL=$NEXTAUTH_URL
ENV NEXTAUTH_SECRET=$NEXTAUTH_SECRET
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_DICTIONARY_API_URL=$NEXT_PUBLIC_DICTIONARY_API_URL
ENV OPENAI_API_KEY=$OPENAI_API_KEY
ENV AUTH_GOOGLE_ID=$AUTH_GOOGLE_ID
ENV AUTH_GOOGLE_SECRET=$AUTH_GOOGLE_SECRET
ENV AUTH_GITHUB_ID=$AUTH_GITHUB_ID
ENV AUTH_GITHUB_SECRET=$AUTH_GITHUB_SECRET
ENV DATABASE_URL=$DATABASE_URL
ENV JWT_SECRET=$JWT_SECRET
ENV LANGCHAIN_API_KEY=$LANGCHAIN_API_KEY
ENV LANGCHAIN_ENDPOINT=$LANGCHAIN_ENDPOINT
ENV LANGCHAIN_PROJECT=$LANGCHAIN_PROJECT
ENV LANGCHAIN_TRACING_V2=$LANGCHAIN_TRACING_V2
ENV MAILER_HOST=$MAILER_HOST
ENV MAILER_PASS=$MAILER_PASS
ENV MAILER_PORT=$MAILER_PORT
ENV MAILER_USER=$MAILER_USER
ENV STORAGE_ACCESS_KEY=$STORAGE_ACCESS_KEY
ENV STORAGE_ACCESS_KEY_ID=$STORAGE_ACCESS_KEY_ID
ENV STORAGE_ID=$STORAGE_ID
ENV STORAGE_NAME=$STORAGE_NAME
ENV AWS_BUCKET_NAME=$AWS_BUCKET_NAME
ENV AWS_DEFAULT_REGION=$AWS_DEFAULT_REGION
ENV AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
ENV AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY

COPY package.json /app
COPY pnpm-lock.yaml /app

COPY . .

RUN pnpm install

RUN pnpm build

EXPOSE 3000

CMD [ "pnpm", "start" ]
