generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  password      String?
  role          String    @default("user")
  isActive      Boolean   @default(false)
  isTwoFa       Boolean   @default(false)
  image         String?
  emailVerified DateTime?
  twoFaHash     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  userSets     Set[]          @relation("userSets")
  ownerSet     Set[]          @relation("ownerSets")
  activity     Activity[]
  notification Notification[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Set {
  id        String   @id @default(uuid())
  userId    String
  ownerId   String?
  title     String
  source    String
  target    String
  list      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation("userSets", fields: [userId], references: [id], onDelete: Cascade)
  owner User? @relation("ownerSets", fields: [ownerId], references: [id], onDelete: Cascade)

  activity     Activity[]
  notification Notification[]
}

model ActivityType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity Activity[]
}

model Activity {
  id             String   @id @default(uuid())
  activityTypeId String
  setId          String
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activityType ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Cascade)
  set          Set          @relation(fields: [setId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  status    String
  setId     String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  set  Set? @relation(fields: [setId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
