    "@radix-ui/react-toast": "^1.2.6",
    "bcryptjs": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "lucide-react": "^0.474.0",
    "next": "15.1.6",
